{
  "name": "pixel-nook",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel Nook \u2014 Swap a cart. Play like it's 1989. Retro cartridge cabinet with twelve games: Snake, Block Drop, Maze Munch, Star Blaster, Brick Bash, Frog Hop, Asteroid Drift, Pixel Paddle, Ladder Climb, Neon Racer, Moon Drop and Tank Duel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "vite build --mode native",
    "native:configure": "node scripts/configure-native.mjs",
    "native:sync": "npm run build:native && npm run native:configure && cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "test": "node --test tests/*.test.js src/mobile/*.test.js",
    "test:e2e": "playwright test",
    "native:check-release": "node scripts/validate-native-release.mjs",
    "native:icons": "node scripts/generate-icons.mjs",
    "android:debug": "npm run native:sync && node scripts/build-android.mjs",
    "android:bundle": "npm run native:sync && node scripts/build-android.mjs bundleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.65.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@fontsource/press-start-2p": "5.3.0",
    "three": "^0.186.1"
  }
}
